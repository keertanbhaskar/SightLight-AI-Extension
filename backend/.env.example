ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql://sightlite:sightlite@localhost:5432/sightlite
# Generate: python -c "import secrets; print(secrets.token_hex(32))"   (>=32 chars enforced in production)
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Comma-separated. Must be explicit origins in production (no "*").
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=10
